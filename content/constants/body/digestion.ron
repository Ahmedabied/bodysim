  (name: "colon_urge_ml", value: 100.0, unit: "mL", range: Some((90.0, 105.0)), varies_with: "-", source: "desire to defecate 90-105 mL", status: Verified, note: None),
  (name: "colon_max_ml", value: 150.0, unit: "mL", range: Some((140.0, 160.0)), varies_with: "-", source: "maximum tolerable 140-160 mL", status: Verified, note: None),
