  (name: "gastric_check_s", value: 600.0, unit: "s", range: None, varies_with: "-", source: "the absorption episode's resolution while a meal empties (a bounded stepped episode); 10 min resolves the 30 min point of a glucose tolerance test", status: Tunable, note: None),
