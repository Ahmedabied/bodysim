// BODY · thermoregulation (Gagge two-node, run as closed-form segments).
// Sources: the Gagge two-node model as implemented in pythermalcomfort (two_nodes_gagge.py).
[
  (name: "tsk_neutral_c", value: 33.7, unit: "degC", range: None, varies_with: "model constant",
   source: "Gagge model neutral skin temp (pythermalcomfort two_nodes_gagge.py)",
   status: Verified, note: None),
  (name: "tcr_neutral_c", value: 36.8, unit: "degC", range: None, varies_with: "model constant",
   source: "Gagge model neutral core temp",
   status: Verified, note: None),
  (name: "tissue_conductance_w_per_m2k", value: 5.28, unit: "W/(m2 K)", range: None,
   varies_with: "model constant",
   source: "HFcs = (Tcr-Tsk)*(5.28 + 1.163*SkBF); 5.28 = minimum tissue conductance",
   status: Verified, note: None),
  (name: "blood_capacity_wh_per_l_k", value: 1.163, unit: "Wh/(L K)", range: None,
   varies_with: "model constant",
   source: "same equation; 1.163 = thermal capacity of blood",
   status: Verified, note: None),
  (name: "skbf_neutral_kg_per_h_m2", value: 6.3, unit: "kg/(h m2)", range: None, varies_with: "-",
   source: "neutral skin blood flow",
   status: Verified, note: None),
  (name: "skbf_max_kg_per_h_m2", value: 90.0, unit: "kg/(h m2)", range: None,
   varies_with: "model default (configurable); measured whole-body max 6-8 L/min",
   source: "maximum skin blood flow, Gagge default",
   status: Verified, note: None),
  (name: "skbf_min_kg_per_h_m2", value: 0.5, unit: "kg/(h m2)", range: None, varies_with: "-",
   source: "SkBF = clamp((6.3+120*warm_cr)/(1+0.5*cold_sk), 0.5, 90)",
   status: Verified, note: None),
  (name: "c_dil", value: 120.0, unit: "1", range: None, varies_with: "model constant",
   source: "vasodilation driving coefficient C_dil",
   status: Verified, note: None),
  (name: "c_str", value: 0.5, unit: "1", range: None, varies_with: "model constant",
   source: "vasoconstriction driving coefficient C_str",
   status: Verified, note: None),
  (name: "c_sw", value: 170.0, unit: "1", range: None, varies_with: "model constant",
   source: "m_rsw = min(170*warm_body*exp(warm_sk/10.7), 500)",
   status: Verified, note: None),
  (name: "sweat_exp_divisor_c", value: 10.7, unit: "degC", range: None, varies_with: "model constant",
   source: "same equation",
   status: Verified, note: None),
  (name: "sweat_max_g_per_h_m2", value: 500.0, unit: "g/(h m2)", range: None,
   varies_with: "model default; real subjects sustain 0.87-1.16 L/h whole-body",
   source: "maximum regulatory sweat rate, Gagge default",
   status: Verified, note: None),
  (name: "sweat_heat_wh_per_g", value: 0.68, unit: "Wh/g", range: None, varies_with: "skin temperature",
   source: "E_rsw = 0.68*m_rsw; equals ~2448 J/g latent heat",
   status: Verified, note: None),
  (name: "skin_mass_fraction", value: 0.1, unit: "1", range: None,
   varies_with: "SkBF (Gagge re-derives alpha = 0.0417737 + 0.7451833/(SkBF+0.585417))",
   source: "alpha default 0.1; Csk = 0.97*alpha*weight, Ccr = 0.97*(1-alpha)*weight (Wh/degC)",
   status: Verified, note: None),
  (name: "body_heat_capacity_wh_per_kg_k", value: 0.97, unit: "Wh/(kg K)", range: None,
   varies_with: "model constant",
   source: "the 0.97 in Csk/Ccr (= 3492 J/(kg K), close to the 3700 J/(kg K) 'flesh' figure in)",
   status: Verified, note: None),
  (name: "met_w_per_m2", value: 58.15, unit: "W/m2", range: Some((58.15, 58.2)),
   varies_with: "convention",
   source: "pythermalcomfort's own constant is 58.15; the general convention is 58.2 (using 58.2 silently diverges from the reference implementation)",
   status: Verified, note: None),
  (name: "met_rest", value: 1.0, unit: "met", range: Some((0.7, 1.4)),
   varies_with: "activity (sleeping 0.7, light activity 1.2-1.4)",
   source: "1 met = seated at rest",
   status: Verified, note: None),
  (name: "respiratory_heat_fraction", value: 0.1, unit: "1", range: None,
   varies_with: "ambient humidity, ventilation",
   source: "no single sourced fraction; Gagge computes Cres+Eres from ambient explicitly",
   status: Tunable, note: Some("a fixed share; respiratory heat loss (Cres/Eres) is not modelled separately")),
  (name: "clo_air_layer_m2k_per_w", value: 0.11, unit: "m2 K/W", range: Some((0.08, 0.15)),
   varies_with: "air speed",
   source: "no published value used: the still-air boundary-layer resistance Ia. clo itself is sourced (1 clo = 0.155 m2 K/W)",
   status: Tunable, note: None),
  (name: "clo_unit_m2k_per_w", value: 0.155, unit: "m2 K/W", range: None, varies_with: "-",
   source: "1 clo = 0.155 m2 K/W (Wikipedia clothing insulation)",
   status: Verified, note: None),
  (name: "clo_indoor_light", value: 0.36, unit: "clo", range: Some((0.08, 1.0)),
   varies_with: "ensemble (t-shirt 0.08; shorts+short-sleeve 0.36; trousers+long-sleeve 0.61)",
   source: "pythermalcomfort clo table",
   status: Verified, note: None),
  // control re-linearisation: how far the state may drift before the LTI segment is re-anchored
  (name: "reanchor_dtsk_c", value: 0.25, unit: "degC", range: None, varies_with: "-",
   source: "an accuracy knob for the piecewise-LTI scheme, not a physiological value. The scheme re-anchors when a control signal flips; this bounds the drift between flips",
   status: Tunable, note: None),
  (name: "reanchor_dtcr_c", value: 0.05, unit: "degC", range: None, varies_with: "-",
   source: "as above",
   status: Tunable, note: None),
  (name: "reanchor_max_span_s", value: 3600.0, unit: "s", range: None, varies_with: "-",
   source: "as above: an upper bound on a single closed-form segment, so a settled body still re-checks hourly",
   status: Tunable, note: None),
  // interoceptive bands (thermal comfort). thirst/bladder bands come from hydration.ron.
  (name: "warm_band_noticeable_c", value: 0.3, unit: "degC above neutral skin", range: None,
   varies_with: "individual",
   source: "no sourced mapping from skin-temperature excess to a felt band exists; alliesthesia gives the sign, not the thresholds",
   status: Tunable, note: None),
  (name: "warm_band_pressing_c", value: 1.2, unit: "degC above neutral skin", range: None,
   varies_with: "individual", source: "as above", status: Tunable, note: None),
  (name: "warm_band_urgent_c", value: 2.2, unit: "degC above neutral skin", range: None,
   varies_with: "individual", source: "as above", status: Tunable, note: None),
]
